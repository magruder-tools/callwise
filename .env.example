# Copy to .env.local in this checkout when you are ready. Never commit secrets.
# Desktop also reads .env.local from its app data directory when packaged.
# No key is required for npm run demo.
OPENAI_API_KEY=
CALLWISE_FAST_MODEL=gpt-5.6-luna
CALLWISE_STRATEGY_MODEL=gpt-6-astra
CALLWISE_TRANSCRIPTION_MODEL=gpt-live-transcribe
# strategy backend: openai or codex (select in the app)
CALLWISE_CODEX_BIN=codex
CALLWISE_CODEX_EFFORT=high
# Optional: Fireflies replaces local transcription. It is not required.
FIREFLIES_API_KEY=
# Optional remote MCP: an explicitly configured, read-only search tool.
CALLWISE_MCP_URL=
CALLWISE_MCP_TOKEN=
CALLWISE_MCP_SEARCH_TOOL=
# JSON template; {{query}} is replaced as data, never executed.
CALLWISE_MCP_SEARCH_ARGUMENTS={"query":"{{query}}"}
