{
  "name": "callwise",
  "productName": "Callwise",
  "version": "0.4.0",
  "description": "A personal thinking copilot for live conversations",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "license": "GPL-3.0-or-later",
  "author": "Callwise contributors",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "electron .",
    "demo": "node scripts/demo-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "check": "node scripts/check.mjs",
    "format": "prettier --write .",
    "doctor": "node scripts/doctor.mjs",
    "dist:mac": "node scripts/bundle-codex.mjs && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:win": "electron-builder --win zip --x64 --publish never",
    "package:source": "node scripts/package-source.mjs",
    "bundle:codex": "node scripts/bundle-codex.mjs",
    "replay": "node scripts/replay.mjs",
    "signing:setup": "node scripts/create-signing-identity.mjs"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "socket.io-client": "4.8.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.7.1",
    "@playwright/test": "1.64.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "linkedom": "0.18.13",
    "prettier": "3.6.2"
  },
  "build": {
    "appId": "local.callwise.desktop",
    "productName": "Callwise",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "core/**",
      "providers/**",
      "ui/**",
      "fixtures/**",
      "assets/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Callwise transcribes your voice while you explicitly run a call session.",
        "NSAudioCaptureUsageDescription": "Callwise transcribes meeting audio while you explicitly run a call session.",
        "NSScreenCaptureUsageDescription": "Callwise uses system capture to hear your selected meeting. Video frames are not sent to AI."
      },
      "minimumSystemVersion": "14.2",
      "identity": "-",
      "sign": "scripts/sign-mac.mjs",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "extraResources": [
      {
        "from": "bundled/codex",
        "to": "codex"
      },
      {
        "from": "README.md",
        "to": "README.md"
      }
    ],
    "dmg": {
      "contents": [
        {
          "x": 140,
          "y": 180,
          "type": "file"
        },
        {
          "x": 420,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "overrides": {
    "argparse": "2.0.1"
  }
}
